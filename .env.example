# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/study-tracker

# Server port
PORT=5000

# Secret key for signing login tokens (change this to any random string)
JWT_SECRET=change_this_to_a_random_secret_string

# PIN for the Manager (parent/guardian) login
MANAGER_PIN=1234

# PIN for the Student login
STUDENT_PIN=9999
